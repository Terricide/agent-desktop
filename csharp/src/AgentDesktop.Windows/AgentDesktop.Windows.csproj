<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AgentDesktop.Windows</RootNamespace>
    <AssemblyName>AgentDesktop.Windows</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Core defines the adapter contract and every shared type. This project
       references Core only: check-architecture.py fails it when it reaches
       another platform project. -->

  <ItemGroup>
    <ProjectReference Include="../AgentDesktop.Core/AgentDesktop.Core.csproj" />
  </ItemGroup>

  <!-- The cursor overlay decodes a system cursor image through GDI+, which the
       net8.0 targeting pack forwards out of System.Drawing to its own package. -->

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentDesktop.Windows.Tests" />
  </ItemGroup>

</Project>
