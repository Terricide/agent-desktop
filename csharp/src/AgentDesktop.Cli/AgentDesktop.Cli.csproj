<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>AgentDesktop.Cli</RootNamespace>
    <!-- The shipped binary is named as the Rust one is, so the C# port is a drop-in for the
    skill examples, the E2E harness, and the npm wrapper. -->
    <AssemblyName>agent-desktop</AssemblyName>
  </PropertyGroup>

  <!-- The binary is one of the two projects allowed to wire a platform adapter. -->
  <ItemGroup>
    <ProjectReference Include="../AgentDesktop.Core/AgentDesktop.Core.csproj" />
    <ProjectReference Include="../AgentDesktop.Windows/AgentDesktop.Windows.csproj" />
  </ItemGroup>

</Project>